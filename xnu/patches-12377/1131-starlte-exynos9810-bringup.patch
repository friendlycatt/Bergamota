+static bool
+sweet_dt_has_string(DTEntry entry, const char *key, const char *want)
+{
+	void const *prop;
+	unsigned int size;
+	if (SecureDTGetProperty(entry, key, &prop, &size) != kSuccess) {
+		return false;
+	}
+	const char *p = prop;
+	size_t len = strlen(want) + 1;
+	while (size != 0) {
+		if (size >= len && memcmp(p, want, len) == 0) {
+			return true;
+		}
+		unsigned int n = 0;
+		while (n < size && p[n] != '\0') {
+			n++;
+		}
+		if (n == size) {
+			break;
+		}
+		p += n + 1;
+		size -= n + 1;
+	}
+	return false;
+}
+
+/* SMCCC 1.0: only x0's result is retained; firmware may clobber x1-x17. */
+int32_t
+sweet_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
+{
+	register uint64_t x0 __asm__("x0") = 0xc4000003ULL;
+	register uint64_t x1 __asm__("x1") = target;
+	register uint64_t x2 __asm__("x2") = entry;
+	register uint64_t x3 __asm__("x3") = context;
+	if (sweet_psci_hvc) {
+		__asm__ volatile("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+	} else {
+		__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+	}
+	return (int32_t)x0;
+}
+
+static void
+sweet_gicv2_init_cpu(void)
+{
+	unsigned int cpu = ml_get_cpu_number_local();
+	uint32_t target = 0;
+	for (unsigned int i = 0; i < 32 && target == 0; i += 4) {
+		target = gicd_read32(GICV2D_ITARGETSR + i);
+		target |= target >> 16;
+		target |= target >> 8;
+		target &= 0xff;
+	}
+	/* ITARGETSR0-7 may be RAZ on a uniprocessor GIC. Self-SGIs use the
+	 * architectural TargetListFilter instead; SMP still needs a real mask. */
+	bool uniprocessor = (gicd_read32(GICV2D_TYPER) & 0xe0) == 0;
+	if (cpu >= SWEET_SMP_MAX_CPUS || (!uniprocessor && target == 0) ||
+	    (target & (target - 1)) != 0) {
+		panic("SWEET GICv2: invalid CPU target cpu=%u mask=0x%x", cpu, target);
+	}
+	/* Quiesce inherited NS PPIs/SGIs. Secure interrupt writes are RAZ/WI. */
+	gicd_write32(GICV2D_ICENABLER, 0xffffffff);
+	gicd_write32(GICV2D_ICPENDR, 0xffffffff);
+	for (unsigned int i = 0; i < 16; i += 4) {
+		gicd_write32(GICV2D_CPENDSGIR + i, 0xffffffff);
+	}
+	/* Two security states: firmware owns Group 0; use Group 1 NS. Without
+	 * the security extension (QEMU virt), Group 0 is our ordinary IRQ group. */
+	gicd_write32(GICV2D_IGROUPR, (gicd_read32(GICV2D_TYPER) & (1U << 10)) ? 0xffffffff : 0);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICV2D_IPRIORITYR + i, 0xa0a0a0a0);
+	}
+	gicd_write32(GICV2D_ISENABLER, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+	_gic_write32(gicc_base + GICV2C_PMR, 0xff);
+	_gic_write32(gicc_base + GICV2C_BPR, 0);
+	/* NS view: bit 0 enables Group 1. EOImodeNS=0: EOIR also deactivates.
+	 * Preserve the firmware's IRQ/FIQ bypass-disable bits, as Linux does. */
+	uint32_t ctlr = _gic_read32(gicc_base + GICV2C_CTLR) & GICV2C_BYPASS_MASK;
+	_gic_write32(gicc_base + GICV2C_CTLR, ctlr | 1);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+	__atomic_store_n(&sweet_gic_cpu_target[cpu], target, __ATOMIC_RELEASE);
+	kprintf("SWEET GICv2: cpu=%u target=0x%x ready\n", cpu, target);
+}
+
+uint32_t
+sweet_gic_ack_irq(uint32_t *intid)
+{
+	uint32_t iar;
+	if (sweet_gic_v2) {
+		iar = _gic_read32(gicc_base + GICV2C_IAR);
+		*intid = iar & 0x3ff; /* bits 12:10 are the SGI's source CPU */
+	} else {
+		iar = (uint32_t)__builtin_arm_rsr64("ICC_IAR1_EL1");
+		*intid = iar & 0xffffff;
+	}
+	return iar;
+}
+
+void
+sweet_gic_eoi_irq(uint32_t iar)
+{
+	/* Complete timer/device writes before deactivating a level interrupt. */
+	__builtin_arm_dsb(DSB_SY);
+	if (sweet_gic_v2) {
+		_gic_write32(gicc_base + GICV2C_EOIR, iar); /* retain SGI source bits */
+	} else {
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	}
+	__builtin_arm_isb(ISB_SY);
+}
+
+void
+sweet_gic_send_ipi(unsigned int logical, uint64_t mpidr)
+{
+	if (sweet_gic_v2) {
+		if (logical >= SWEET_SMP_MAX_CPUS) {
+			panic("SWEET GICv2: invalid SGI target %u", logical);
+		}
+		if (logical == ml_get_cpu_number_local()) {
+			__builtin_arm_dsb(DSB_ISHST);
+			gicd_write32(GICV2D_SGIR, (2U << 24) | SWEET_IPI_SGI);
+			__builtin_arm_isb(ISB_SY);
+			return;
+		}
+		uint32_t target = __atomic_load_n(&sweet_gic_cpu_target[logical], __ATOMIC_ACQUIRE);
+		if (target == 0) {
+			panic("SWEET GICv2: cpu=%u has no target mask", logical);
+		}
+		__builtin_arm_dsb(DSB_ISHST);
+		gicd_write32(GICV2D_SGIR, (target << 16) | SWEET_IPI_SGI);
+	} else {
+		unsigned int aff0 = mpidr & 0xff;
+		if (aff0 >= 16) {
+			panic("SWEET GICv3: SGI target requires unsupported range selector");
+		}
+		uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
+		    (((mpidr >> 16) & 0xff) << 32) | (((mpidr >> 8) & 0xff) << 16) |
+		    ((uint64_t)SWEET_IPI_SGI << 24) | (1ULL << aff0);
+		__builtin_arm_dsb(DSB_ISHST);
+		__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+	}
+	__builtin_arm_isb(ISB_SY);
+}
+#endif /* SWEET */
 
