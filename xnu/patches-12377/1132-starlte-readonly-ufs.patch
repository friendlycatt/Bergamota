+static int
+ufs_find_partition(const char *want)
+{
+	static const uint8_t tur[6] = { 0x00 };
+	if (!su.exynos) {
+		return ufs_gpt_find_on_lun(want, &su.first_block, &su.nblocks);
+	}
+	int last_error = ENOENT;
+	for (su.lun = 0; su.lun < 8 && !su.dead; su.lun++) {
+		int error = ufs_scsi(tur, sizeof(tur), 0, false);
+		if (!error) { error = ufs_read_capacity(); }
+		if (!error) { error = ufs_gpt_find_on_lun(want, &su.first_block, &su.nblocks); }
+		if (!error) {
+			return 0;
+		}
+		printf("STARLTE UFS: LUN %u scan result %d%s\n", su.lun, error,
+		    su.dead ? " (host stopped)" : "");
+		last_error = error;
+	}
