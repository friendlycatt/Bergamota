+/* Exact ASCII names in UTF-16LE. Samsung uses uppercase partition names;
+ * only case is ignored there. Non-ASCII suffixes must not become matches.
+ */
+static bool
+ufs_partition_name(const uint8_t *entry, const char *want)
+{
+	for (unsigned i = 0; i < 36; i++) {
+		unsigned ch = entry[56 + i * 2] | (unsigned)entry[57 + i * 2] << 8;
+		unsigned w = (unsigned char)want[i];
+		if (ch > 0x7f) {
+			return false;
+		}
+		if (su.exynos) {
+			if (ch >= 'A' && ch <= 'Z') { ch += 'a' - 'A'; }
+			if (w >= 'A' && w <= 'Z') { w += 'a' - 'A'; }
+		}
+		if (ch != w) {
+			return false;
+		}
+		if (!ch) {
+			return true;
+		}
+	}
+	return want[36] == 0;
