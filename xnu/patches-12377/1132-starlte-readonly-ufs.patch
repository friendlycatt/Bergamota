+	su.device_blocks = 0;
+	int error = ufs_scsi(cap10, sizeof(cap10), 8, false);
+	if (error) { return error; }
+	uint64_t last = be32(b);
+	uint32_t size = be32(b + 4);
+	if (last == UINT32_MAX) {
+		error = ufs_scsi(cap16, sizeof(cap16), 32, false);
+		if (error) { return error; }
+		last = (uint64_t)be32(b) << 32 | be32(b + 4);
+		size = be32(b + 8);
+	}
+	if (size < DEV_BSIZE || size > 4096 || (size & (size - 1)) ||
+	    last < 2 || last == UINT64_MAX || last + 1 > UINT64_MAX / size) {
+		printf("STARLTE UFS: LUN %u unsupported capacity last 0x%llx block %u\n", su.lun, last, size);
+		return EINVAL;
+	}
+	su.block_size = size;
+	su.device_blocks = last + 1;
+	printf("STARLTE UFS: LUN %u capacity %llu MiB, %llu blocks x %u bytes\n",
+	    su.lun, su.device_blocks * size >> 20, su.device_blocks, size);
+	return 0;
