+static int
+exynos_dma_handoff(DTEntry node)
+{
+	uint64_t pool[2], image[2], ram, ram_size;
+	DTEntry chosen;
+	if (!ufs_dt_read(node, "dma-pool", pool, sizeof(pool)) ||
+	    !ufs_dt_read(node, "loader-image", image, sizeof(image)) ||
+	    SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    !ufs_dt_read(chosen, "dram-base", &ram, sizeof(ram)) ||
+	    !ufs_dt_read(chosen, "dram-size", &ram_size, sizeof(ram_size)) ||
+	    !image[0] || !image[1] || image[0] >= (1ull << 32) || image[1] > (1ull << 32) - image[0] ||
+	    (pool[0] & PAGE_MASK) || pool[1] != DMA_SIZE || pool[0] < image[0] ||
+	    pool[0] >= image[0] + image[1] || pool[1] > image[0] + image[1] - pool[0] ||
+	    !ram_size || ram_size > UINT64_MAX - ram ||
+	    (image[0] < ram + ram_size && ram < image[0] + image[1])) {
+		printf("STARLTE UFS: invalid/missing Image-owned DMA32 handoff; use the new Enxerto\n");
+		return ENXIO;
+	}
+	su.dma_pa = pool[0];
+	su.dma_nc = true;
+	su.dma = ml_io_map_wcomb(pool[0], pool[1]);
+	if (!su.dma) { return ENOMEM; }
+	bzero((void *)su.dma, su.dma_size);
+	printf("STARLTE UFS: DMA32 0x%llx+0x%llx inside Image 0x%llx+0x%llx, Normal-NC\n",
+	    pool[0], pool[1], image[0], image[1]);
+	return 0;
