 		    result, exynos_rd(EXYNOS_TXPRDT), exynos_rd(EXYNOS_RXPRDT), exynos_rd(EXYNOS_NEXUS));
@@ -1458,6 +1542,14 @@
 	printf("SWEET UFS: hce 0x%x hcs 0x%x cap 0x%x ver 0x%x is 0x%x utrlba 0x%x:%x dbr 0x%x rsr 0x%x\n",
 	    ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(REG_CAP), ufs_rd(0x08), ufs_rd(REG_IS),
 	    ufs_rd(REG_UTRLBAU), ufs_rd(REG_UTRLBA), ufs_rd(REG_UTRLDBR), ufs_rd(REG_UTRLRSR));
+	if (su.exynos) {
+		printf("STARLTE UFS: inherited tm dbr 0x%x rsr 0x%x, TX/RX 0x%x/0x%x nexus 0x%x\n",
+		    ufs_rd(REG_UTMRLDBR), ufs_rd(REG_UTMRLRSR),
+		    exynos_rd(EXYNOS_TXPRDT), exynos_rd(EXYNOS_RXPRDT), exynos_rd(EXYNOS_NEXUS));
+		printf("STARLTE UFS: inherited swrst 0x%x gpio 0x%x clkstop 0x%x force 0x%x\n",
+		    exynos_rd(EXYNOS_SW_RST), exynos_rd(EXYNOS_GPIO),
+		    exynos_rd(EXYNOS_CLKSTOP), exynos_rd(EXYNOS_FORCEHCS));
+	}
 	if (!su.exynos) {
 		kern_return_t kr = kmem_alloc_contig(kernel_map, &su.dma, su.dma_size, PAGE_MASK, 0, 0,
 		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT);
