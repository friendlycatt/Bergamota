+/* starlte-pre-submit-uic-boundaries-v1: each register is read only once
+ * at each boundary. UIC reads may clear latches; persist the raw values
+ * and quarantine before any later setup or submission can hide them.
+ * These sequential observations are not an atomic or passive snapshot.
+ */
+static int
+exynos_ufs_check_boundary(bool before_tur)
+{
+	if (!su.exynos || !su.boundary_probe) { return 0; }
+	if (su.dead) { return EIO; }
+	uint8_t bit = 1u << before_tur;
+	if (su.boundary_seen & bit) { return 0; }
+	struct exynos_ufs_boundary *s = &su.boundary[before_tur];
+	s->is = ufs_rd(REG_IS);
+	s->hce = ufs_rd(REG_HCE);
+	s->hcs = ufs_rd(REG_HCS);
+	s->dbr = ufs_rd(REG_UTRLDBR);
+	s->tm_dbr = ufs_rd(REG_UTMRLDBR);
+	s->uic[0] = ufs_rd(REG_UECPA);
+	s->uic[1] = ufs_rd(REG_UECDL);
+	s->uic[2] = ufs_rd(REG_UECN);
+	s->uic[3] = ufs_rd(REG_UECT);
+	s->uic[4] = ufs_rd(REG_UECDME);
+	su.boundary_seen |= bit;
+	if ((s->is & UFS_IS_ERR_MASK) || s->uic[0] || s->uic[1] ||
+	    s->uic[2] || s->uic[3] || s->uic[4]) {
+		s->error = EIO;
+	} else if (s->dbr || s->tm_dbr) {
+		s->error = EBUSY;
+	} else if ((s->hcs & 0xffu) != HCS_EXYNOS_RDY || (before_tur && !(s->hce & 1u))) {
+		s->error = ENXIO;
+	}
+	if (s->error) {
+		su.dead = true;
+		ss.last_is = s->is;
+		ss.last_hcs = s->hcs;
+		if (s->is & UFS_IS_ERR_MASK) { ss.is_errors++; }
+	}
+	return s->error;
+}
+
+/* Print only at the probe hold, never between the final sample and the
+ * first TUR doorbell. No MMIO or DMA is read here, even after quarantine.
+ * Two two-line records per boot, independent of the pre-cleanup samples.
+ */
+static void
+exynos_ufs_log_boundaries(void)
+{
+	for (unsigned i = 0; i < 2; i++) {
+		uint8_t bit = 1u << i;
+		if (!(su.boundary_seen & bit) || (su.boundary_logged & bit)) { continue; }
+		su.boundary_logged |= bit;
+		const struct exynos_ufs_boundary *s = &su.boundary[i];
+		printf("STARLTE UFS: boundary %s IS %08x HCE %x HCS %x DBR %x TM %x%s\n",
+		    i ? "pre-TUR" : "pre-enable", s->is, s->hce, s->hcs, s->dbr, s->tm_dbr,
+		    s->error ? " STOP" : "");
+		printf("STARLTE UFS: boundary UIC PA %08x DL %08x NL %08x TL %08x DME %08x\n",
+		    s->uic[0], s->uic[1], s->uic[2], s->uic[3], s->uic[4]);
+	}
+}
