+/* HCE/UCRDY only describe the host command interface. Samsung follows HCE
+ * initialization with local CPort setup, LINKSTARTUP and a UTP handshake.
+ * All UIC operations here run with both request lists stopped and idle.
+ * GET_GENERRCODE_DIRECT requires LINKSTARTUP's UniPro CNF result; generic
+ * UICARG2 is recorded but is not authoritative for that command on 9810.
+ */
+static int
+exynos_ufs_uic(uint32_t command, uint16_t attr, uint32_t *value)
+{
+	if (!su.exynos || !su.link_init || !su.unipro || su.dead) { return EIO; }
+	if (command != UIC_DME_GET && command != UIC_DME_SET && command != UIC_LINKSTARTUP) {
+		return EINVAL;
+	}
+	if (command != UIC_LINKSTARTUP && !value) { return EINVAL; }
+	uint32_t is = ufs_rd(REG_IS), hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	uint32_t codes[5], result = UINT32_MAX, arg2 = UINT32_MAX, ack_is = 0;
+	bool submitted = false, completed = false, line_reset = false;
+	int error = 0;
+	if (ufs_rd(REG_UTRLDBR) || ufs_rd(REG_UTMRLDBR) ||
+	    ((ufs_rd(REG_UTRLRSR) | ufs_rd(REG_UTMRLRSR)) & 1u)) {
+		error = EBUSY;
+	} else if (!(hce & 1u) || !(hcs & HCS_UCRDY) || (hcs & 0xf0u)) {
+		error = ENXIO;
+	} else if (is & UFS_IS_ERR_MASK) {
+		error = EIO;
+	}
+	for (unsigned i = 0; i < 5; i++) { codes[i] = ufs_rd(REG_UECPA + 4u * i); }
+	if (codes[0] || codes[1] || codes[2] || codes[3] || codes[4]) { error = EIO; }
+	if (error) { goto out; }
+
+	/* A stale completion must not make an unexecuted command look successful. */
+	ufs_wr(REG_IS, IS_UIC_COMPLETE);
+	__builtin_arm_dsb(0xf);
+	is = ufs_rd(REG_IS);
+	if (is & (IS_UIC_COMPLETE | UFS_IS_ERR_MASK)) { error = EIO; goto out; }
+	ufs_wr(REG_UICARG1, (uint32_t)attr << 16);
+	ufs_wr(REG_UICARG2, 0);
+	ufs_wr(REG_UICARG3, command == UIC_DME_SET ? *value : 0);
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_UICCMD, command);
+	__builtin_arm_dsb(0xf);
+	submitted = true;
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(UIC_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	is = 0;
+	/* Also cap iterations if the inherited counter ever stops advancing. */
+	for (unsigned poll = 0; poll < 5000; poll++) {
+		is |= ufs_rd(REG_IS); /* retain an earlier error even if its latch clears */
+		if (is & IS_UIC_COMPLETE) { completed = true; break; }
+		if ((is & (UFS_IS_ERR_MASK & ~4u)) ||
+		    ((is & 4u) && command != UIC_LINKSTARTUP)) { break; }
+		if (mach_absolute_time() >= deadline) { break; }
+		delay(100);
+	}
+	hce = ufs_rd(REG_HCE);
+	hcs = ufs_rd(REG_HCS);
+	arg2 = ufs_rd(REG_UICARG2);
+	result = command == UIC_LINKSTARTUP ? exynos_unipro_rd(EXYNOS_LINK_CNF) & 0xffu : arg2 & 0xffu;
+	for (unsigned i = 0; i < 5; i++) { codes[i] = ufs_rd(REG_UECPA + 4u * i); }
+	/* A successful LINKSTARTUP can itself raise PA.LINERESET (Linux ufshcd
+	 * consumes UECPA after startup). Permit only that exact indication in
+	 * this command's completion, never before startup or during a transfer.
+	 */
+	line_reset = command == UIC_LINKSTARTUP && completed && !result &&
+	    (is & UFS_IS_ERR_MASK) == 4u && codes[0] == 0x80000010u &&
+	    !codes[1] && !codes[2] && !codes[3] && !codes[4];
+	if (((is & UFS_IS_ERR_MASK) || codes[0] || codes[1] || codes[2] || codes[3] || codes[4]) &&
+	    !line_reset) {
+		error = EIO;
+	} else if (!completed) {
+		error = ETIMEDOUT;
+	} else if (result) {
+		error = EIO;
+	} else if (!(hce & 1u) || !(hcs & HCS_UCRDY) || (hcs & 0xf0u)) {
+		error = ENXIO;
+	} else if (ufs_rd(REG_UTRLDBR) || ufs_rd(REG_UTMRLDBR) ||
+	    ((ufs_rd(REG_UTRLRSR) | ufs_rd(REG_UTMRLRSR)) & 1u)) {
+		error = EBUSY;
+	}
+	if (!error) {
+		if (command == UIC_DME_GET) { *value = ufs_rd(REG_UICARG3); }
+		ufs_wr(REG_IS, IS_UIC_COMPLETE | (is & IS_LINKSTARTUP) | (line_reset ? 4u : 0u));
+		__builtin_arm_dsb(0xf);
+		ack_is = ufs_rd(REG_IS);
+		if (ack_is & (IS_UIC_COMPLETE | UFS_IS_ERR_MASK)) { error = EIO; }
+	}
+out:
+	if (error || command == UIC_LINKSTARTUP) {
+		printf("STARLTE UFS: UIC %02x attr %04x sent %u done %u result %x arg2 %x ack %x error %d\n",
+		    command, attr, submitted, completed, result, arg2, ack_is, error);
+		printf("STARLTE UFS: UIC setup IS %08x HCE %x HCS %x PA %08x DL %08x NL %08x TL %08x DME %08x\n",
+		    is, hce, hcs, codes[0], codes[1], codes[2], codes[3], codes[4]);
+	}
+	if (error) {
+		su.dead = true;
+		ss.last_is = is | ack_is;
+		ss.last_hcs = hcs;
+		if (ss.last_is & UFS_IS_ERR_MASK) { ss.is_errors++; }
+	}
+	return error;
+}
