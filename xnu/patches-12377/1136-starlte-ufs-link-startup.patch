+static int
+exynos_ufs_keep_awake(void)
+{
+	/* exynos_ufs_pre_setup_clocks(on): preserve unrelated bits, disable
+	 * automatic core/HW clock gating and unstop the inherited link clocks.
+	 * The starlte DT selects hw-rev 5; its refclk mux is not changed here.
+	 */
+	exynos_wr(EXYNOS_FORCEHCS, exynos_rd(EXYNOS_FORCEHCS) & ~EXYNOS_CORE_AUTOGATE);
+	exynos_wr(EXYNOS_CLKSTOP, exynos_rd(EXYNOS_CLKSTOP) & ~EXYNOS_LINK_CLKSTOP);
+	exynos_wr(EXYNOS_ACGDIS, exynos_rd(EXYNOS_ACGDIS) | 1u);
+	__builtin_arm_dsb(0xf);
+	if ((exynos_rd(EXYNOS_FORCEHCS) & EXYNOS_CORE_AUTOGATE) ||
+	    (exynos_rd(EXYNOS_CLKSTOP) & EXYNOS_LINK_CLKSTOP) ||
+	    !(exynos_rd(EXYNOS_ACGDIS) & 1u)) {
+		su.dead = true;
+		printf("STARLTE UFS: warm-start clock controls did not take\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+exynos_ufs_start_link(bool initialized)
+{
+	int error;
+	if (initialized) {
+		/* HCE initialization may have reset vendor clock controls. Samsung
+		 * also sets these in its post-HCE, pre-link notification.
+		 */
+		error = exynos_ufs_keep_awake();
+		if (error) { return error; }
+		/* ufs-cal-9810.c init_cfg: local device 0, valid, peer 1, CPort
+		 * connected. Keep PHY calibration/timing inherited from firmware.
+		 */
+		static const uint16_t attrs[] = { 0x3000, 0x3001, 0x4021, 0x4020 };
+		for (unsigned i = 0; i < 4; i++) {
+			uint32_t value = i ? 1 : 0;
+			error = exynos_ufs_uic(UIC_DME_SET, attrs[i], &value);
+			if (error) { return error; }
+		}
+		error = exynos_ufs_uic(UIC_LINKSTARTUP, 0, NULL);
+		if (error) { return error; }
+	}
+	uint32_t tx = 0, rx = 0, connected = 0;
+	if ((error = exynos_ufs_uic(UIC_DME_GET, 0x1561, &tx)) ||
+	    (error = exynos_ufs_uic(UIC_DME_GET, 0x1581, &rx)) ||
+	    (error = exynos_ufs_uic(UIC_DME_GET, 0x4020, &connected))) { return error; }
+	uint32_t hcs = ufs_rd(REG_HCS);
+	printf("STARLTE UFS: warm link %s TX/RX %u/%u CPort %u HCS %x\n",
+	    initialized ? "started" : "inherited", tx, rx, connected, hcs);
+	if (!tx || tx > 2 || !rx || rx > 2 || connected != 1 || (hcs & 0xffu) != HCS_EXYNOS_RDY) {
+		su.dead = true;
+		return ENXIO;
+	}
+	return 0;
+}
