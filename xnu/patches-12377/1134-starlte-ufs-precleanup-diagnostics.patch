+/* Samsung ufshci.h/ufshcd_update_uic_error: IS.UIC_ERROR alone cannot
+ * distinguish PA/DL/NL/TL/DME failures. Save the first observed error and
+ * terminal state before UTRLCLR/IS acknowledgement can obscure the evidence.
+ * These are bounded, non-atomic live samples, never completion validation.
+ */
+struct exynos_ufs_sample {
+	uint32_t is, hce, hcs, dbr, dbr_after, rsr, tm_dbr, tm_rsr, base, baseu;
+	uint32_t uic[5], trd[8];
+	uint8_t response[16];
+};
+
+static void
+exynos_ufs_capture(struct exynos_ufs_sample *s, uint32_t is)
+{
+	s->is = is;
+	s->hce = ufs_rd(REG_HCE);
+	s->hcs = ufs_rd(REG_HCS);
+	s->dbr = ufs_rd(REG_UTRLDBR);
+	s->rsr = ufs_rd(REG_UTRLRSR);
+	s->tm_dbr = ufs_rd(REG_UTMRLDBR);
+	s->tm_rsr = ufs_rd(REG_UTMRLRSR);
+	s->base = ufs_rd(REG_UTRLBA);
+	s->baseu = ufs_rd(REG_UTRLBAU);
+	s->uic[0] = ufs_rd(REG_UECPA);
+	s->uic[1] = ufs_rd(REG_UECDL);
+	s->uic[2] = ufs_rd(REG_UECN);
+	s->uic[3] = ufs_rd(REG_UECT);
+	s->uic[4] = ufs_rd(REG_UECDME);
+	/* Exynos owns a Normal-NC arena. Do not clean/write controller-owned
+	 * memory, chase descriptor addresses, or inspect the media buffer.
+	 * Volatile loads retain actual observations even while DMA is pending.
+	 */
+	const volatile uint32_t *trd = (const volatile uint32_t *)(su.dma + DMA_UTRL);
+	const volatile uint8_t *resp = (const volatile uint8_t *)(su.dma + DMA_UCD +
+	    offsetof(struct ucd, resp));
+	__builtin_arm_dsb(0xf);
+	for (unsigned i = 0; i < 8; i++) {
+		s->trd[i] = trd[i];
+	}
+	for (unsigned i = 0; i < sizeof(s->response); i++) {
+		s->response[i] = resp[i];
+	}
+	__builtin_arm_dsb(0xf);
+	s->dbr_after = ufs_rd(REG_UTRLDBR);
+}
+
+static void
+exynos_ufs_log_sample(const struct exynos_ufs_sample *s, const char *phase, uint8_t op)
+{
+	printf("STARLTE UFS: %s cmd %02x lun %u IS %08x HCE %x HCS %x (live sample)\n",
+	    phase, op, su.lun, s->is, s->hce, s->hcs);
+	printf("STARLTE UFS: UIC PA %08x DL %08x NL %08x TL %08x DME %08x\n",
+	    s->uic[0], s->uic[1], s->uic[2], s->uic[3], s->uic[4]);
+	printf("STARLTE UFS: list %08x:%08x DBR %x->%x RSR %x TM %x/%x\n",
+	    s->baseu, s->base, s->dbr, s->dbr_after, s->rsr, s->tm_dbr, s->tm_rsr);
+	printf("STARLTE UFS: UTRD0-3 LE %08x %08x %08x %08x (OCS %02x)\n",
+	    s->trd[0], s->trd[1], s->trd[2], s->trd[3], s->trd[2] & 0xff);
+	printf("STARLTE UFS: UTRD4-7 LE %08x %08x %08x %08x\n",
+	    s->trd[4], s->trd[5], s->trd[6], s->trd[7]);
+	printf("STARLTE UFS: RESP0-15 BE %08x %08x %08x %08x\n",
+	    be32(s->response), be32(s->response + 4), be32(s->response + 8), be32(s->response + 12));
+}
